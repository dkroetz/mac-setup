# Use zsh (macOS default) as default shell
command = /bin/zsh

# Keybinds
## Get terminal focus with `Ctrl + <` key
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Auto-update settings (stable = stable releases, tip = nightly builds)
auto-update = check
auto-update-channel = tip

# Style settings
background-opacity = 1
theme = Material Darker
font-family = Sauce Code Pro Font Mono

# SSH
shell-integration-features = ssh-env,ssh-terminfo
