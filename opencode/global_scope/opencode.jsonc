{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "scout",
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "read": {
      "*": "allow",
      // Deny access to environment variable files to prevent accidental leaks
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
    },
    "edit": {
      "*": "ask",
      "~/.config/opencode/**": "ask",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "write": {
      "*": "ask",
      "~/.config/opencode/**": "ask",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
  },
  "plugin": ["./plugins/session-notify.ts"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "duckdb": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-motherduck",
        "--db-path",
        "/Users/denis/.local/share/opencode/opencode.db",
      ],
      "enabled": true,
    },
  },
  // Keep dynamic behavior metadata-first: lean AGENTS.md, focused skills,
  // deeper context loaded only when the task needs it.
  "agent": {
    "plan": {
      "disable": false,
      "hidden": true,
    },
    "build": {
      "disable": false,
      "hidden": true,
    },
  },
}
