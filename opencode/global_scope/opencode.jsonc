{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "scout",
  "disabled_providers": ["xai", "togetherai", "opencode"],
  "provider": {
    "opencode-go": {
      "blacklist": [
        "kimi-k2.5",
        "glm-5",
        "mimo-v2.5-pro",
        "qwen3.6-plus",
        "qwen3.7-max",
        "minimax-m2.5",
        "minimax-m2.7",
        "deepseek-v4-flash",
        "deepseek-v4-pro",
      ],
    },
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "read": {
      "*": "allow",
    },
    "edit": {
      "*": "ask",
      "~/.config/opencode/**": "ask",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "write": {
      "*": "ask",
      "~/.config/opencode/**": "ask",
      "**/.opencode/**": "allow",
      "**/.agents/**": "allow",
    },
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
  },
  "plugin": [],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false,
    },
  },
  "agent": {
    "plan": {
      "disable": false,
      "hidden": true,
    },
    "build": {
      "disable": false,
      "hidden": true,
    },
  },
}
