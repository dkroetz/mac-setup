{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "default_agent": "build",
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          ".scratch/**": "allow"
        }
      },
      "options": {}
    }
  },
  "mcp": {
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--snapshot-mode=none"
      ],
      "enabled": false
    },
    "xmcp": {
      "enabled": false,
      "type": "local",
      "command": [
        "/Users/denis/.config/opencode/xmcp/.venv/bin/python",
        "/Users/denis/.config/opencode/xmcp/server.py"
      ],
      "timeout": 300000,
      "environment": {
        "MCP_TRANSPORT": "stdio",
        "X_BEARER_TOKEN": "{env:X_BEARER_TOKEN}",
        "X_OAUTH_CONSUMER_KEY": "{env:X_OAUTH_CONSUMER_KEY}",
        "X_OAUTH_CONSUMER_SECRET": "{env:X_OAUTH_CONSUMER_SECRET}"
      }
    }
  },
  // Provider Configuration
  "disabled_providers": ["togetherai", "openrouter", "kilo", "inception"],
  "provider": {
    "futilify-gw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Futilify Gateway v2",
      "options": {
        "baseURL": "https://v2.futilify.com/v1",
        "apiKey": "{env:FUTILIFY_GW_V2_API_KEY}"
      }
    },
    "opencode": {
      "whitelist": ["north-mini-code-free", "opencode/nemotron-3-ultra-free"]
    },
    "opencode-go": {
      "blacklist": [
        "kimi-k2.5",
        "kimi-k2.6",
        "glm-5",
        "mimo-v2.5-pro",
        "qwen3.6-plus",
        "qwen3.7-max",
        "minimax-m2.5",
        "minimax-m2.7",
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ]
    },
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Grok Composer 2.5 Fast"
        }
      }
    },
    "openai": {},
    "google": {
      "whitelist": ["gemma-4-31b-it", "gemini-3.5-flash"]
    }
  },
  "plugin": [
    "./plugin/futilify-gw.ts",
    "./plugin/browserless-url-fix.ts",
  ]
}
