{
  "profile": "balanced",
  "date": "2026-03-03",
  "intent": "Conservative defaults with low-friction safe operations",
  "changes": {
    "kept_conservative": {
      "edit": "ask",
      "write": "ask",
      "bash_default": "ask"
    },
    "relaxed_bash_allowlist": [
      "pytest",
      "pytest *",
      "mypy",
      "mypy *",
      "ruff check",
      "ruff check *",
      "pdm run pytest*",
      "pdm run mypy*",
      "pdm run ruff check*"
    ],
    "existing_safe_git_allowlist": [
      "git status*",
      "git diff*",
      "git log*",
      "git show*",
      "git branch",
      "git branch --list*",
      "git tag --list*",
      "git remote*",
      "git rev-parse*",
      "git ls-files*",
      "git ls-tree*",
      "git cat-file*"
    ],
    "explicitly_not_relaxed": [
      "destructive git commands",
      "general shell wildcard escalation",
      "direct write/edit permission"
    ]
  },
  "validation_expectations": {
    "safe_commands_run_without_prompt": true,
    "unsafe_commands_still_prompt": true
  }
}
