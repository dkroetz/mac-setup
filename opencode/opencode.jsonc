{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent": {
    // ===========================================
    // KILO-STYLE PRIMARY AGENTS
    // ===========================================

    "architect": {
      "mode": "primary",
      "prompt": "{file:./agents/architect.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Plan and design before implementation",
      "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": "ask",
        "write": "ask",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "code": {
      "mode": "primary",
      "prompt": "{file:./agents/code.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Write, modify, and refactor code",
      "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": "ask",
        "write": "ask",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "ask": {
      "mode": "primary",
      "prompt": "{file:./agents/ask.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Get answers and explanations (read-only)",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "allow",
        "write": "deny",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "debug": {
      "mode": "primary",
      "prompt": "{file:./agents/debug.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Diagnose and fix software issues",
      "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": "ask",
        "write": "ask",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "review": {
      "mode": "primary",
      "prompt": "{file:./agents/review.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Review code changes locally",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    // ===========================================
    // KILO-STYLE SUBAGENTS
    // ===========================================

    "orchestrator": {
      "mode": "subagent",
      "prompt": "{file:./agents/orchestrator.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "description": "Coordinate tasks across multiple agents"
    },

    // ===========================================
    // RESEARCH AGENTS (existing)
    // ===========================================

    "research": {
      "mode": "primary",
      "prompt": "{file:./agents/research.md}",
      "model": "kilo-code/z-ai/glm-5:free",
      "temperature": 0.2
    },
    "research-official": {
      "mode": "subagent",
      "prompt": "{file:./agents/research-official.md}",
      "model": "kilo-code/arcee-ai/trinity-large-preview:free"
    },
    "research-examples": {
      "mode": "subagent",
      "prompt": "{file:./agents/research-examples.md}",
      "model": "kilo-code/arcee-ai/trinity-large-preview:free"
    },
    "research-code": {
      "mode": "subagent",
      "prompt": "{file:./agents/research-code.md}",
      "model": "kilo-code/arcee-ai/trinity-large-preview:free"
    },
    "research-news": {
      "mode": "subagent",
      "prompt": "{file:./agents/research-news.md}",
      "model": "kilo-code/arcee-ai/trinity-large-preview:free"
    },
    "research-academic": {
      "mode": "subagent",
      "prompt": "{file:./agents/research-academic.md}",
      "model": "kilo-code/arcee-ai/trinity-large-preview:free"
    }
  },
  "provider": {
    "kilo-code": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo Code",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway",
        "apiKey": "${env:KILO_GATEWAY_API_KEY}"
      },
      "models": {
        "arcee-ai/trinity-large-preview:free": {
          "name": "Arcee Trinity Large Preview Free"
        },
        "corethink:free": {
          "name": "CoreThink Free"
        },
        "giga-potato": {
          "name": "Giga Potato Free"
        },
        "minimax/minimax-m2.1:free": {
          "name": "Minimax M2.1 Free"
        },
        "z-ai/glm-5:free": {
          "name": "Z.AI GLM 5 Free"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}