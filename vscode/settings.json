{
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Catppuccin Alt Mocha",
  "workbench.iconTheme": "catppuccin-perfect-latte",
  "window.zoomLevel": 1.5,
  "breadcrumbs.enabled": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": false,
  "git.useEditorAsCommitInput": true,
  "git.autofetch": true,
  "git.enableCommitSigning": true,
  "json.format.keepLines": true,
  "security.workspace.trust.untrustedFiles": "open",
  "update.showReleaseNotes": false,
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": true,
  "zenMode.hideLineNumbers": false,

  // Editor Settings
  "editor.fontLigatures": false,
  "editor.fontWeight": "500",
  "editor.fontSize": 13,
  "editor.lightbulb.enabled": "onCode",
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.suggest.insertMode": "replace",
  "editor.formatOnSave": false,
  "editor.accessibilitySupport": "off",
  "editor.screenReaderAnnounceInlineSuggestion": false,

  // Terminal Settings
  "terminal.integrated.fontWeight": 550,
  "workbench.colorCustomizations": {
    // The background is optional
    // "terminal.background": "#282a36",
    "terminalCursor.background": "#282a36",
    "terminalCursor.foreground": "#97979b",
    "terminal.selectionBackground": "#97979b33",
    "terminal.foreground": "#eff0eb",
    "terminal.ansiBlack": "#282a36",
    "terminal.ansiRed": "#ff5c57",
    "terminal.ansiGreen": "#5af78e",
    "terminal.ansiYellow": "#f3f99d",
    "terminal.ansiBlue": "#57c7ff",
    "terminal.ansiMagenta": "#ff6ac1",
    "terminal.ansiCyan": "#9aedfe",
    "terminal.ansiWhite": "#f1f1f0",
    "terminal.ansiBrightBlack": "#686868",
    "terminal.ansiBrightRed": "#ff5c57",
    "terminal.ansiBrightGreen": "#5af78e",
    "terminal.ansiBrightYellow": "#f3f99d",
    "terminal.ansiBrightBlue": "#57c7ff",
    "terminal.ansiBrightMagenta": "#ff6ac1",
    "terminal.ansiBrightCyan": "#9aedfe",
    "terminal.ansiBrightWhite": "#eff0eb"
  },
  "terminal.integrated.defaultProfile.osx": "fish",
  "workbench.productIconTheme": "a-file-icon-vscode-product-icon-theme",

  // GitHub Copilot Settings
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "github.copilot.chat.codesearch.enabled": true,

  // Python Settings
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.defaultFoldingRangeProvider": "charliermarsh.ruff"
  },
  // Ruff configuration
  "ruff.organizeImports": true,
  "ruff.fixAll": true,

  "python.analysis.autoFormatStrings": true,
  "python.analysis.autoImportCompletions": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "jupyter.runStartupCommands": ["%load_ext autoreload", "%autoreload 2"],
  "jupyter.askForKernelRestart": false,
  "notebook.output.textLineLimit": 40,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.editorOptionsCustomizations": {
    "editor.tabSize": 4,
    "editor.indentSize": 4,
    "editor.insertSpaces": true
  },

  // Other Extensions Settings
  "redhat.telemetry.enabled": true,
  "githubLocalActions.dockerDesktopPath": "/Applications/Docker.app",

  // Detaulf Formatter Settings
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.trailingComma": "none",
  "python.analysis.typeCheckingMode": "standard",
  "[terraform]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "[terraform-vars]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "python.venvFolders": [
    "~/Repos/ds-uc10-automatic-company-profiles/packages/webcrawler",
    "~/Repos/uc16-sales-navigator/packages/app/backend",
    "~/Repos/bhi/packages/cn_extract",
    "~/Repos/streamio_databricks/packages/company_name_matching",
    "~/Repos/streamio_databricks/packages/dummy_bundle",
    // "~/Repos/stuff/serve_data",
    // "~/Repos/poc-streamio-orchestrators/packages/dummy_bundle",
    // "~/Repos/poc-streamio-orchestrators/packages/northdata_processing",
    // "~/Repos/poc-streamio-orchestrators/packages/streamio",
    // "~/Library/Application Support/pdm/venvs/",
    "~/dev/python/pdm/venvs/"
  ],
  "python.analysis.extraPaths": [
    "./packages/dummy_bundle/src",
    "./packages/dummy_bundle"
  ],
  "chat.agent.maxRequests": 50,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "python.defaultInterpreterPath": "/Users/denis.kroetz/Repos/streamio-databricks/packages/dummy_bundle/.venv",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "terminal.external.linuxExec": "ghostty",
  "terminal.external.osxExec": "Ghostty.app",
  "sonarlint.connectedMode.connections.sonarcloud": [
    {
      "organizationKey": "ventio",
      "connectionId": "ventio",
      "region": "EU"
    }
  ],
  "sonarlint.focusOnNewCode": false,
  "sonarlint.automaticAnalysis": false,
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {},
  "git.openRepositoryInParentFolders": "always",
  "files.associations": {
    "*.jinja": "jinja"
  },
  "githubPullRequests.pullBranch": "never",
  "editor.defaultFormatter": "charliermarsh.ruff",
  "chat.viewSessions.orientation": "stacked"
}
