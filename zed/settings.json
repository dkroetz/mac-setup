// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // General Settings
  "calls": {
    "mute_on_join": true
  },
  "vim_mode": true,
  "cli_default_open_behavior": "new_window",
  // UI Configuration
  "ui_font_size": 18.0,
  "ui_font_weight": 500.0,
  "ui_font_family": "Hack Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Zedokai Darker (Filter Octagon)",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  // Buffer Settings
  "buffer_font_size": 17.0,
  "buffer_font_weight": 500,
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_line_height": "standard",
  // AI Configuration
  "agent_ui_font_size": 14.5,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.4-mini",
        "mode": "auto"
      },
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "type": "registry",
    },
  },
  "language_models": {
    "opencode": {
      "show_free_models": true,
      "show_zen_models": true,
    },
  },
  "agent": {
    "thinking_display": "preview",
    "default_profile": "write",
    "default_model": {
      "provider": "opencode",
      "model": "free/nemotron-3-super-free",
      "enable_thinking": false,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  // Menu Configuration
  // Right Dock
  "project_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  // Tab Bar
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show": false,
  },
  "tabs": {
    "file_icons": true,
  },
  // Title Bar
  "title_bar": {
    "show_menus": false,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": true,
  },
  // Status Bar (Bottom)
  "bottom_dock_layout": "contained",
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false,
    "cursor_position_button": true,
  },
  "debugger": {
    "button": true,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "gutter": {
    "line_numbers": true,
  },
  "terminal": {
    "button": false,
  },
  // Language Settings
  "languages": {
    "Python": {
      "language_servers": ["ruff", "basedpyright"],
      "format_on_save": "on",
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true,
      },
    },
    "JSON": {
      "format_on_save": "off",
    },
    "JSONC": {
      "format_on_save": "off",
    },
    "YAML": {
      "format_on_save": "off",
    },
  },
}
